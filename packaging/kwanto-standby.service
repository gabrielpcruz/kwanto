[Unit]
Description=Kwanto: consulta de standby dos HDDs
After=local-fs.target

[Service]
# Único processo do Kwanto com acesso aos discos: consulta o modo de energia de cada HDD (ATA CHECK
# POWER MODE) e grava /run/kwanto-standby/estado.json para o kwantod. Sem rede e com usuário próprio,
# para que nem o kwantod consiga usar este privilégio.
ExecStart=/usr/libexec/kwanto/kwanto-standby
User=kwanto-standby
# Grupo kwanto: só o kwantod lê o estado gravado (0640); o usuário continua separado do kwantod.
Group=kwanto
SupplementaryGroups=disk
AmbientCapabilities=CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_RAWIO
DevicePolicy=closed
DeviceAllow=block-sd r
RuntimeDirectory=kwanto-standby
RuntimeDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=10
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
PrivateIPC=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
