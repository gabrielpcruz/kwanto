<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Kwanto</vendor>
  <vendor_url>https://github.com/gabrielpcruz/kwanto</vendor_url>
  <action id="io.github.gabrielpcruz.kwanto.atualizar">
    <description>Atualizar o Kwanto</description>
    <message>Para instalar a versão nova do Kwanto, digite a senha de administrador</message>
    <icon_name>kwanto</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kwanto/kwanto-atualizar</annotate>
  </action>
</policyconfig>
